# Copy to .env and change every password before sharing the deployment.

# Bootstrap superuser used by docker-compose and by the init scripts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=incidents

# One login role per component (see db/init/001_roles.sh).
#   agent_ro      -> used by the MCP server only; sees one incident, never truth/eval
#   scorer_ro     -> used by the scorer only; reads evidence + truth + eval
#   generator_rw  -> used by the dataset generator; writes evidence + truth
#   harness_rw    -> used by the run harness; writes eval
AGENT_RO_PASSWORD=change-me-agent
SCORER_RO_PASSWORD=change-me-scorer
GENERATOR_RW_PASSWORD=change-me-generator
HARNESS_RW_PASSWORD=change-me-harness

# Where application code finds the database.
IV_PG_HOST=localhost
IV_PG_PORT=5432
IV_PG_DB=incidents
