%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#FFFFFF",
    "primaryBorderColor": "#E2722E",
    "primaryTextColor": "#1F1006",
    "lineColor": "#6B5646",
    "clusterBkg": "#FBF7F0",
    "clusterBorder": "#E9D5C0",
    "fontFamily": "Arial",
    "fontSize": "15px"
  },
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 30,
    "rankSpacing": 45,
    "wrappingWidth": 800
  }
}}%%
flowchart TB

  subgraph S1["Step 1: Setup with Docker"]
    direction LR
    compose["docker compose up<br/>same PostgreSQL 16 on any machine"]
    init["Init scripts<br/>roles, tables, row-level security"]
    generator["Seeded generator<br/>loads incidents and answer keys"]
    batch["Batch runner<br/>starts one investigation"]
    compose --> init
    init --> generator
    generator --> batch
  end

  subgraph S2["Step 2: Python routing"]
    direction LR
    blackboard[("Blackboard in SQLite<br/>tasks, facts, causes, objections<br/>one private file per run")]
    inbox[("Direct messages<br/>6 per run, a reply is free")]
    router{"Python router<br/>not a model<br/>who speaks next?<br/>up to 30 turns"}
    blackboard -->|"reads the state"| router
    inbox -.->|"a message wakes its receiver"| router
  end

  subgraph S3["Step 3: Six agents"]
    direction LR
    orchestrator["Orchestrator<br/>plans the work"]
    observability["Observability<br/>logs and metrics"]
    dependency["Dependency<br/>changes and topology"]
    reasoning["Reasoning<br/>ranks 2 to 4 causes"]
    critic["Critic<br/>tries to disprove the top cause"]
    reporting["Reporting<br/>final report or inconclusive"]

    orchestrator -->|"open task"| observability
    orchestrator -->|"open task"| dependency
    observability -->|"new facts"| reasoning
    dependency -->|"new facts"| reasoning
    reasoning -->|"new ranking"| critic
    critic -->|"approved or limit reached"| reporting
    critic -->|"blocked: follow-up task to a specialist"| observability
  end

  subgraph S4["Step 4: Model and tools"]
    direction LR
    llm["LLM client<br/>claude -p, Pydantic v2"]
    claude["Anthropic Claude Haiku<br/>one call per agent step"]
    llm --> claude
    gateway["ToolGateway, an MCP client<br/>validates, retries, budgets, logs"]
    mcp["MCP server over stdio<br/>one per run, read-only"]
    tools["5 tools<br/>logs, metrics, changes,<br/>dependencies, past incidents"]
    gateway --> mcp
    mcp --> tools
  end

  subgraph S5["Step 5: PostgreSQL data"]
    direction TB
    evidence[("Evidence<br/>agent_ro, one incident only")]
    results[("Results<br/>runs, calls, scores")]
    answerkey[("Answer key<br/>scorer_ro only, hidden from agents")]
  end

  subgraph S6["Step 6: Score and show"]
    direction LR
    scorer["Scorer<br/>compares report with the key"]
    viewer["Web viewer<br/>FastAPI, Chart.js, Mermaid"]
    tailscale["Tailscale Funnel<br/>public HTTPS"]
    person["Reviewer<br/>browser"]
    scorer --> viewer
    viewer --> tailscale
    tailscale --> person
  end

  S1 -->|"incident brief"| S2
  S2 <-->|"router wakes the next agent, agents write records and messages back, repeat"| S3
  S3 -->|"agents only send requests"| S4
  S4 -->|"read-only queries"| S5
  S3 -->|"final report is saved"| S5
  S5 -->|"only the Scorer reads the key"| S6

  classDef agent fill:#B4400A,stroke:#B4400A,color:#FFFFFF,font-weight:bold;
  classDef decision fill:#2B1A10,stroke:#2B1A10,color:#FFFFFF,font-weight:bold;
  classDef store fill:#FFE3CF,stroke:#E2722E,color:#1F1006;
  classDef locked fill:#2B1A10,stroke:#2B1A10,color:#FFFFFF;
  class orchestrator,observability,dependency,reasoning,critic,reporting agent;
  class router decision;
  class blackboard,inbox,evidence,results store;
  class answerkey locked;
